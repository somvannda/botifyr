# Botifyr Cloud configuration
# Copy to .env and adjust as needed.

PORT=8787
HOST=0.0.0.0

# --- Persistence -----------------------------------------------------------------
# memory (default, zero setup) | postgres (durable, multi-user)
BOTIFYR_STORE=memory
# DATABASE_URL=postgres://botifyr:botifyr@localhost:54329/botifyr

# --- Secret vault ----------------------------------------------------------------
# 64 hex chars (32 bytes), or any passphrase (derived). Unset = ephemeral dev key.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BOTIFYR_VAULT_KEY=

# --- Agent model -----------------------------------------------------------------
# mock (default, no key) | openai | openrouter | deepseek | groq | ollama | auto
BOTIFYR_PROVIDER=mock
# BOTIFYR_MODEL=
# BOTIFYR_API_KEY=
# BOTIFYR_BASE_URL=
BOTIFYR_MAX_STEPS=12

# --- Cost controls (per user; learn from Chmaba) ---------------------------------
# Hard cap on output tokens per model call.
BOTIFYR_MAX_OUTPUT_TOKENS=1024
# How many past turns (and max characters per turn) to send for context.
BOTIFYR_MAX_HISTORY_TURNS=12
BOTIFYR_MAX_MESSAGE_CHARS=4000
# Per-user sliding-window message limit (0 disables).
BOTIFYR_RATE_LIMIT_PER_HOUR=60
# Per-user daily token budget across all model calls (0 disables).
# Exceeding it shows a warning to the user but does NOT block requests.
BOTIFYR_DAILY_TOKEN_BUDGET=200000
# Comma-separated emails that become platform admins (moderate learned skills, manage users).
# BOTIFYR_ADMIN_EMAILS=you@example.com
# Exact-match response cache (seconds). A cache hit costs zero tokens. 0 disables.
BOTIFYR_CACHE_TTL_SECONDS=300
# Compress old turns into a rolling summary instead of dropping them. 0 disables.
BOTIFYR_SUMMARY=1
BOTIFYR_SUMMARY_MAX_TOKENS=300
# Hard cap on TOTAL tokens (prompt + completion) for one task run (0 disables).
BOTIFYR_MAX_TASK_TOKENS=0
# 1 = the daily budget above becomes a hard cap (over-budget requests get HTTP 429).
BOTIFYR_ENFORCE_BUDGET=0

# --- Browser isolation -----------------------------------------------------------
# local = in-process Playwright (development)
# docker = one throwaway container per task (recommended; needs the image built)
BOTIFYR_SANDBOX=local
# BOTIFYR_SANDBOX_IMAGE=botifyr/browser-sandbox:1.63.0

# --- Capabilities ----------------------------------------------------------------
# Comma-separated: browser, computer, code
BOTIFYR_CAPABILITIES=browser
# BOTIFYR_DESKTOP_IMAGE=botifyr/desktop-sandbox:1
# BOTIFYR_CODE_IMAGE=botifyr/code-sandbox:1

# --- Downloads & media -----------------------------------------------------------
# Where task downloads land (the shared volume mounted into the code sandbox).
BOTIFYR_DOWNLOADS_DIR=/downloads
BOTIFYR_DOWNLOADS_VOLUME=botifyr-downloads
# Delete a task's files this many days after last activity (0 = keep forever).
BOTIFYR_MEDIA_RETENTION_DAYS=30
# Trim the oldest folders when the volume exceeds this many MB (0 = unlimited).
BOTIFYR_MEDIA_QUOTA_MB=0
# How often (minutes) the retention sweep runs.
BOTIFYR_MEDIA_CLEANUP_MINUTES=360

# --- Security --------------------------------------------------------------------
# Comma-separated origins allowed to call this API from a browser. Defaults cover
# the local dev ports and the botifyr.xyz subdomains. "*" disables the check
# (unsafe — local debugging only).
# BOTIFYR_ALLOWED_ORIGINS=
# Leave empty for OPEN signup; set a comma-separated allowlist to restrict who
# can create an account.
# BOTIFYR_ALLOWED_EMAILS=

# --- P2P / device transfer (optional) --------------------------------------------
# A TURN relay lets two of the user's devices connect behind strict NAT. Expose
# either a full JSON array, or a single TURN server:
# BOTIFYR_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
# BOTIFYR_TURN_URL=turn:turn.example.com:3478
# BOTIFYR_TURN_USERNAME=
# BOTIFYR_TURN_CREDENTIAL=

# --- Channels --------------------------------------------------------------------
# The authenticated local chat API (/channels/local/*) is always available.
# Telegram turns on automatically when a bot token is set.
# TELEGRAM_BOT_TOKEN=

# --- Model keys (only the one you use) -------------------------------------------
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# DEEPSEEK_API_KEY=
# GROQ_API_KEY=

# --- Google sign-in (browser-handled, like Grok Bot) -----------------------------
# Create an OAuth 2.0 Client ID (type: Web application) in Google Cloud Console
# and add the redirect URI below to its "Authorized redirect URIs".
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8787/auth/google/callback

# --- Connect apps (Gmail / Calendar / Drive) -------------------------------------
# Reuses the sign-in OAuth client. Add this redirect URI to the same client and
# enable the Gmail / Calendar / Drive APIs (+ scopes) on the OAuth consent screen.
# GOOGLE_CONNECT_REDIRECT_URI=http://localhost:8787/auth/google/connect/callback

# --- Billing (Stripe, optional) --------------------------------------------------
# Plans are trial (default) and pro. Stripe is off unless all three are set:
# STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_WEBHOOK_SECRET=
